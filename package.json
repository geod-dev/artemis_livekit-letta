{
  "name": "artemis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:gateway": "node scripts/check.mjs gateway",
    "check:agent-server": "node scripts/check.mjs agent-server",
    "check:web": "node scripts/check.mjs web",
    "check:voice": "node scripts/check.mjs voice",
    "check:device-client": "node scripts/check.mjs device-client",
    "check:mobile": "node scripts/check.mjs mobile",
    "check:packages": "node scripts/check.mjs packages",
    "check:deploy": "node scripts/check.mjs deploy",
    "check:schema": "node scripts/check.mjs schema",
    "check:boundaries": "node scripts/check.mjs boundaries",
    "typecheck:packages": "pnpm --filter \"./packages/*\" -r run typecheck",
    "test:packages": "pnpm --filter \"./packages/*\" -r run test",
    "generate:present-tool": "node --experimental-strip-types --no-warnings scripts/generate-present-tool.ts",
    "smoke:agent-server": "node scripts/smoke-agent-server.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
