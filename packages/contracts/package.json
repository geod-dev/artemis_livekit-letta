{
  "name": "@artemis/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API contracts, the generative UI library and generated present-tool schemas shared by the frontend, the backend and the agent-server. No runtime dependencies: the UI library is a devDependency, read only by the frontend and the schema generator.",
  "exports": {
    "./chat-types": "./src/chat-types.ts",
    "./agent-server": "./src/agent-server.ts",
    "./present-validation": "./src/present-validation.ts",
    "./present-library": "./src/present-library.ts",
    "./present-tool.json": "./generated/present-tool.json",
    "./present-components.json": "./generated/present-components.json"
  },
  "dependencies": {},
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@assistant-ui/react-generative-ui": "^0.0.24",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  }
}
