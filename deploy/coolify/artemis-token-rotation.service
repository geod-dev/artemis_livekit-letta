[Unit]
Description=Renew the Artemis Coolify deployment token
After=docker.service

[Service]
Type=oneshot
User=artemis-deploy
Group=artemis-deploy
# The docker group is needed only here: rotate_token.py reaches Coolify's console through
# `docker exec`. Membership is root-equivalent, so the poller does not get it.
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /usr/local/lib/artemis/rotate_token.py
TimeoutStartSec=120
# No Restart=: a failed run is retried by the monthly timer, not hourly, because each attempt
# issues and then revokes a Coolify token.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/artemis /var/lib/artemis-deploy
