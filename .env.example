# Copy to `.env` (repo root). Docker Compose, the gateway (apps/gateway/), the web app's
# Vite config (apps/web/), the agent server (apps/agent-server/) and the voice agent
# (apps/voice-agent/) all read this one file.
#
# Values are literal: Compose and the Node and Python loaders do not expand ${VAR} here.
# Edit the addresses below by hand when you change the host.

# Address clients use to reach this host, and the LiveKit node address. For a deployment,
# set the machine's LAN or public IPv4 address; 127.0.0.1 is the local-development default.
IP_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Host folders and ports (Compose)
# ---------------------------------------------------------------------------
# Compose defaults are gitignored folders under ./data/. Production must set both roots to
# separate absolute paths outside apps/ (docker-compose.prod.yml requires them). The
# containers run as uid 1001, so these folders must be owned by 1001:1001.
# WORKSPACE_PATH=/data/artemis/workspace
# ARTEMIS_DATA_DIR=/data/artemis/data/gateway
# Host bind addresses and the port of the web service (nginx, container port 8080).
# WEB_BIND=127.0.0.1
# WEB_PORT=5180
# LIVEKIT_SIGNAL_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Postgres (postgres service). Compose creates the `artemis` (agent-server) and
# `hindsight` (memory) databases and roles when the postgres-pg18 volume is empty.
# REQUIRED: set all three passwords to random values before starting (compose refuses
# to start without them; the agent-server refuses placeholder values in production).
# DATABASE_URL below must carry the same ARTEMIS_DB_PASSWORD for host-run development.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
ARTEMIS_DB_PASSWORD=
HINDSIGHT_DB_PASSWORD=
# agent-server database URL for host-run development. Replace the placeholder password.
DATABASE_URL=postgresql://artemis:<ARTEMIS_DB_PASSWORD>@127.0.0.1:5432/artemis

# ---------------------------------------------------------------------------
# LLM providers: Claude for the assistant and memory; Telnyx GLM for workers.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional. The default is the Groq OpenAI-compatible endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Workers call Telnyx directly through the OpenAI-compatible protocol.
OPENAI_COMPATIBLE_BASE_URL=https://api.telnyx.com/v2/ai/openai
OPENAI_COMPATIBLE_API_KEY=
# Claude model used by the Hindsight memory container.
HINDSIGHT_LLM_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Assistant and worker model handles.
# Text: effort per turn (default medium) with adaptive thinking.
# Voice: medium effort with thinking disabled.
# Workers: provider effort high, independently of the text selection.
# ---------------------------------------------------------------------------
ASSISTANT_MODEL=anthropic/claude-haiku-5-5
ASSISTANT_TASK_MODEL=openai-compatible/zai-org/GLM-5.3-Flash
# Model for conversation titles. Blank falls back to ASSISTANT_MODEL.
ASSISTANT_TITLE_MODEL=
# Groq Whisper model for the composer's mic button (uses GROQ_API_KEY above).
ASSISTANT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Assistant identity.
# ---------------------------------------------------------------------------
ASSISTANT_NAME=Artemis
# IANA time zone. The code default is UTC; set your own, for example Europe/Paris.
# ASSISTANT_TIMEZONE=UTC
# Offers the `present` tool to new conversations.
ASSISTANT_PRESENT_TOOL=false

# ---------------------------------------------------------------------------
# agent-server (apps/agent-server). Compose sets AGENT_SERVER_URL and the container
# HINDSIGHT_URL; the values here are for host-run development.
# ---------------------------------------------------------------------------
# Bearer token shared by the gateway and the agent server. Production must replace
# the development value; agent-server refuses it when NODE_ENV=production.
AGENT_SERVER_TOKEN=dev-agent-server-token-change-me
AGENT_SERVER_URL=http://127.0.0.1:4000
AGENT_SERVER_PORT=4000
# Hindsight memory service for host runs. Leave blank to disable memory. Compose ignores this
# value: containers always use http://hindsight:8888.
HINDSIGHT_URL=http://127.0.0.1:8888
# Hindsight API key, if the Hindsight deployment requires one.
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=artemis
# Retain memory after every N user turns.
MEMORY_RETAIN_EVERY=3
# Milliseconds: idle lifetime of a conversation worker, and the point at which
# a foreground shell command moves to the background.
WORKER_IDLE_TIMEOUT_MS=120000
BASH_BACKGROUND_AFTER_MS=10000
# MCP servers (web search, ...) are added in the app: Settings -> MCP servers.

# ---------------------------------------------------------------------------
# Gateway (apps/gateway/) and web (apps/web/). The Vite dev server listens on 5173.
# ---------------------------------------------------------------------------
# The gateway's port, and where the web dev server (/api proxy) and the voice agent reach it.
GATEWAY_PORT=3000
GATEWAY_URL=http://127.0.0.1:3000

# Required: single-user password. Changing it invalidates all browser sessions.
# Production must use a unique, non-development value.
ARTEMIS_PASSWORD=
# Separate bearer credential for trusted devices; never use the browser password here.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARTEMIS_DEVICE_TOKEN=

# ---------------------------------------------------------------------------
# LiveKit (used by the Compose server and the app)
# ---------------------------------------------------------------------------
LIVEKIT_URL=ws://127.0.0.1:7880
# HTTPS deployments: browser signaling through the HTTPS reverse proxy (deploy/https/setup.sh
# writes this value).
# LIVEKIT_PUBLIC_URL=wss://your-public-ip/livekit
# REQUIRED: set both LiveKit values before starting (compose refuses to start without
# them). Use a random key and a random secret, e.g. `openssl rand -hex 16` and
# `openssl rand -hex 32`. Never ship a shared or development value.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=assistant

# ---------------------------------------------------------------------------
# Voice agent (apps/voice-agent/)
# ---------------------------------------------------------------------------
# REQUIRED: replace the placeholder with a random secret (e.g. `openssl rand -hex 32`). The
# gateway and the voice agent must share this value. The placeholder is not a secret.
VOICE_GATEWAY_TOKEN=change-me-voice-token
# Groq transcribes speech; Deepgram generates speech.
VOICE_STT=groq/whisper-large-v3-turbo
VOICE_TTS=deepgram/flux-hannah-en
VOICE_LANGUAGE=en
VOICE_GREETING=Hi, I'm listening.
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Logging and runtime (optional)
# ---------------------------------------------------------------------------
# LOG_LEVEL=info
# NODE_ENV=development   # Compose sets production for the containers; host runs only.
# WORKSPACE_RUN_AS=1001:1001   # uid:gid for agent commands; Compose sets it for the containers.
# ARTEMIS_URL=http://127.0.0.1:3000   # device client (apps/device-client) server address.
