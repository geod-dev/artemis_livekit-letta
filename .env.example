# Copy to `.env` (repo root). Docker Compose, the backend (backend/), the frontend
# (frontend/) and the voice agent (agent/) all read this one file.

# Address clients use to reach this host. Set this to the machine's LAN/public
# IPv4 address when deploying; 127.0.0.1 is the local-development default.
IP_ADDRESS=127.0.0.1

# Persistent host roots. Set both to separate absolute paths in production.
# The containers see WORKSPACE_PATH=/workspace and ASSISTANT_DATA_ROOT=/data/backend.
# Existing files under the old workspace/data root need a deliberate migration;
# see docs/deployment.md before changing an existing installation.
# WORKSPACE_PATH=/data/artemis/workspace
# ASSISTANT_DATA_ROOT=/data/artemis/backend-data
# LETTA_DATA_VOLUME=livekit-letta_letta-data
# LETTA_DATA_EXTERNAL=true
# LIVEKIT_SIGNAL_BIND=127.0.0.1
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=5180

# ---------------------------------------------------------------------------
# LLM providers — Claude for the assistant; Telnyx GLM for workers.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Telnyx workers use the OpenAI-compatible protocol through the Compose proxy.
OPENAI_COMPATIBLE_BASE_URL=https://api.telnyx.com/v2/ai/openai
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# Assistant and worker model handles.
# Text: low, medium (default), high with adaptive thinking.
# Voice: medium effort with thinking disabled.
# Workers: provider effort high, independently of the text selection.
# ---------------------------------------------------------------------------
ASSISTANT_MODEL=anthropic/claude-haiku-5-5
ASSISTANT_TASK_MODEL=openai-compatible/zai-org/GLM-5.3-Flash
# Launch a background memory reflection every N agent steps (plus after every call).
ASSISTANT_REFLECTION_STEPS=12
# Groq Whisper model for the composer's mic button (uses GROQ_API_KEY above).
ASSISTANT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Assistant identity. The Letta agent is looked up by LETTA_AGENT_NAME and
# created on first use.
# ---------------------------------------------------------------------------
ASSISTANT_NAME=Artemis
ASSISTANT_TIMEZONE=Europe/Paris
LETTA_AGENT_NAME=personal-assistant
# Optional internal/default thread identity. Set only to the known Letta
# conversation ID that should be hidden from the user chat list.
LETTA_DEFAULT_CONVERSATION_ID=

# ---------------------------------------------------------------------------
# Letta App Server
# ---------------------------------------------------------------------------
LETTA_URL=http://${IP_ADDRESS}:4500
# Shared bearer token between the backend and the Letta server. Production must
# replace the development value with an explicitly configured secret.
LETTA_SERVER_TOKEN=dev-letta-token-change-me

# ---------------------------------------------------------------------------
# Background work (Letta's native workers). MCP servers (web search, ...) are
# added in the app: Settings -> MCP servers.
# ---------------------------------------------------------------------------
# Where the Letta container reaches the backend to hand over background-task
# notifications (default: http://host.docker.internal:3000).
# ASSISTANT_GATEWAY_URL=http://host.docker.internal:3000

# ---------------------------------------------------------------------------
# Backend (backend/) and frontend (frontend/, port 5173)
# ---------------------------------------------------------------------------
# The backend's port, and where the frontend's dev server proxies /api to.
BACKEND_PORT=3000
BACKEND_URL=http://${IP_ADDRESS}:3000

# Required: single-user password. Changing it invalidates all browser sessions.
# Production must use a unique, non-development value.
ARTEMIS_PASSWORD=
# Separate bearer credential for trusted devices; never use the browser password here.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARTEMIS_DEVICE_TOKEN=
# Internal address reachable by both the backend and Letta for per-device MCP endpoints.
# Docker Compose sets this to http://backend:3000. For host-based development:
# MCP_DEVICE_BASE_URL=http://host.docker.internal:3000

# ---------------------------------------------------------------------------
# LiveKit (used by the Compose server and the app)
# ---------------------------------------------------------------------------
LIVEKIT_URL=ws://${IP_ADDRESS}:7880
# HTTPS deployments: browser signaling through the HTTPS reverse proxy.
# LIVEKIT_PUBLIC_URL=wss://your-public-ip/livekit
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=5180
# Production must set both LiveKit values explicitly.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=assistant

# ---------------------------------------------------------------------------
# Voice agent (agent/)
# ---------------------------------------------------------------------------
# Where the voice agent reaches the backend, and the token it presents.
GATEWAY_URL=http://${IP_ADDRESS}:3000
# Production must replace the development token with an explicit secret.
VOICE_GATEWAY_TOKEN=dev-voice-token-change-me
# Groq transcribes speech; Deepgram generates speech.
VOICE_STT=groq/whisper-large-v3-turbo
VOICE_TTS=deepgram/flux-hannah-en
VOICE_LANGUAGE=en
VOICE_GREETING=Hi, I'm listening.
DEEPGRAM_API_KEY=
