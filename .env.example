# Copy to `.env` (repo root). Docker Compose, the backend (backend/), the frontend
# (frontend/), the agent server (services/agent-server/) and the voice agent (agent/)
# all read this one file.

# Address clients use to reach this host. Set this to the machine's LAN/public
# IPv4 address when deploying; 127.0.0.1 is the local-development default.
IP_ADDRESS=127.0.0.1

# Persistent host roots. Set both to separate absolute paths in production.
# Host folder mounted at /workspace in agent-server and backend.
# Compose default: ./backend/.workspace
# WORKSPACE_PATH=/data/artemis/workspace
# Host folder for data written by the containers. Mounted at /workspace/data in
# agent-server and at /data/backend in backend. Compose default: ./backend/.workspace/data
# ASSISTANT_DATA_ROOT=/data/artemis/backend-data
# LIVEKIT_SIGNAL_BIND=127.0.0.1
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=5180

# ---------------------------------------------------------------------------
# Postgres (postgres service). Compose creates the `artemis` (agent-server) and
# `hindsight` (memory) databases and roles when the postgres-data volume is empty.
# The values below are development placeholders; set real secrets in production.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=dev-postgres-password-change-me
ARTEMIS_DB_PASSWORD=dev-artemis-db-password-change-me
HINDSIGHT_DB_PASSWORD=dev-hindsight-db-password-change-me
# agent-server database URL for host-run development. Compose sets the container URL.
DATABASE_URL=postgresql://artemis:${ARTEMIS_DB_PASSWORD}@127.0.0.1:5432/artemis

# ---------------------------------------------------------------------------
# LLM providers: Claude for the assistant and memory; Telnyx GLM for workers.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Workers call Telnyx directly through the OpenAI-compatible protocol.
OPENAI_COMPATIBLE_BASE_URL=https://api.telnyx.com/v2/ai/openai
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# Assistant and worker model handles.
# Text: effort per turn (default medium) with adaptive thinking.
# Voice: medium effort with thinking disabled.
# Workers: provider effort high, independently of the text selection.
# ---------------------------------------------------------------------------
ASSISTANT_MODEL=anthropic/claude-haiku-5-5
ASSISTANT_TASK_MODEL=openai-compatible/zai-org/GLM-5.3-Flash
# Model for conversation titles. Blank falls back to ASSISTANT_MODEL.
ASSISTANT_TITLE_MODEL=
# Groq Whisper model for the composer's mic button (uses GROQ_API_KEY above).
ASSISTANT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Assistant identity.
# ---------------------------------------------------------------------------
ASSISTANT_NAME=Artemis
ASSISTANT_TIMEZONE=Europe/Paris
# Offers the `present` tool to new conversations.
ASSISTANT_PRESENT_TOOL=false

# ---------------------------------------------------------------------------
# agent-server (services/agent-server). Compose sets AGENT_SERVER_URL and
# HINDSIGHT_URL for the containers; the values here are for host-run development.
# ---------------------------------------------------------------------------
# Bearer token shared by the backend and the agent server. Production must replace
# the development value; agent-server refuses it when NODE_ENV=production.
AGENT_SERVER_TOKEN=dev-agent-server-token-change-me
AGENT_SERVER_URL=http://127.0.0.1:4000
AGENT_SERVER_PORT=4000
# Hindsight memory service. Leave HINDSIGHT_URL blank to disable memory.
HINDSIGHT_URL=http://127.0.0.1:8888
# Hindsight API key, if the Hindsight deployment requires one.
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=artemis
# Retain memory after every N user turns.
MEMORY_RETAIN_EVERY=3
# Milliseconds: idle lifetime of a conversation worker, and the point at which
# a foreground shell command moves to the background.
WORKER_IDLE_TIMEOUT_MS=120000
BASH_BACKGROUND_AFTER_MS=10000
# MCP servers (web search, ...) are added in the app: Settings -> MCP servers.

# ---------------------------------------------------------------------------
# Backend (backend/) and frontend (frontend/, port 5173)
# ---------------------------------------------------------------------------
# The backend's port, and where the frontend's dev server proxies /api to.
BACKEND_PORT=3000
BACKEND_URL=http://${IP_ADDRESS}:3000

# Required: single-user password. Changing it invalidates all browser sessions.
# Production must use a unique, non-development value.
ARTEMIS_PASSWORD=
# Separate bearer credential for trusted devices; never use the browser password here.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARTEMIS_DEVICE_TOKEN=
# Internal address the agent-server uses to reach the backend's per-device MCP
# endpoints. Compose sets http://backend:3000 for the containers; this is the
# host-run value.
MCP_DEVICE_BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# LiveKit (used by the Compose server and the app)
# ---------------------------------------------------------------------------
LIVEKIT_URL=ws://${IP_ADDRESS}:7880
# HTTPS deployments: browser signaling through the HTTPS reverse proxy.
# LIVEKIT_PUBLIC_URL=wss://your-public-ip/livekit
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=5180
# Production must set both LiveKit values explicitly.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=assistant

# ---------------------------------------------------------------------------
# Voice agent (agent/)
# ---------------------------------------------------------------------------
# Where the voice agent reaches the backend, and the token it presents.
GATEWAY_URL=http://${IP_ADDRESS}:3000
# Production must replace the development token with an explicit secret.
VOICE_GATEWAY_TOKEN=dev-voice-token-change-me
# Groq transcribes speech; Deepgram generates speech.
VOICE_STT=groq/whisper-large-v3-turbo
VOICE_TTS=deepgram/flux-hannah-en
VOICE_LANGUAGE=en
VOICE_GREETING=Hi, I'm listening.
DEEPGRAM_API_KEY=
