{
  "name": "@artemis/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types --no-warnings \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@artemis/contracts": "workspace:*",
    "@assistant-ui/react": "^0.15.25",
    "@assistant-ui/react-generative-ui": "^0.0.24",
    "@assistant-ui/react-streamdown": "^0.3.19",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/figtree": "^5.2.8",
    "@livekit/components-react": "^2.9.24",
    "@react-aria/interactions": "^3.28.1",
    "@streamdown/code": "^2.0.0",
    "@streamdown/mermaid": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "livekit-client": "^2.22.3",
    "lucide-react": "^0.555.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.3.1",
    "tw-shimmer": "^0.4.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vite": "^7",
    "zod": "^4.6.5"
  }
}
