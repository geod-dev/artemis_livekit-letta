{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The tests import browser modules (fetch, window), so the DOM library is needed here too.
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node"],
    // Temporary, as in tsconfig.json: the test sources predate these base options.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false
  },
  "include": ["vite.config.ts", "src/**/*.test.ts"]
}
