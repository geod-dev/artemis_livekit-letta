{
  "name": "@artemis/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node --experimental-transform-types src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@artemis/contracts": "workspace:*",
    "@artemis/mcp": "workspace:*",
    "@artemis/workspace": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "hono": "^4.10.1",
    "livekit-server-sdk": "^2.19.1"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}
